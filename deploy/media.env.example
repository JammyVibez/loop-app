# VPS media storage — merge these into the server's .env.local.
# Anything left blank is optional unless marked required; defaults are shown.
# Full setup: deploy/UPLOADS.md

# Directory outside the app checkout. Nginx serves it at /media/.
MEDIA_STORAGE_ROOT=/var/loop-uploads

# Absolute base used in OG cards, share images and push payloads. Leave unset
# to keep same-origin /media URLs.
# MEDIA_PUBLIC_BASE=https://loopapp.me/media

# REQUIRED for the queue-recovery timer: must match the app process.
MEDIA_WORKER_SECRET=

# REQUIRED for backups: rclone destination (b2:loop-media or r2:loop-media).
MEDIA_BACKUP_REMOTE=

# Slack/Discord webhook that receives backup failures.
MEDIA_ALERT_WEBHOOK=

# Optional tuning (defaults shown).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# MEDIA_FFMPEG_TIMEOUT_MS=1200000
# MEDIA_MAX_PROCESSING_ATTEMPTS=3
# MEDIA_BACKUP_TRANSFERS=4

# Only needed if MEDIA_BUNDLE_SECRET is not set: signed links for private
# developer-project bundles. Falls back to JWT_SECRET.
# MEDIA_BUNDLE_SECRET=
