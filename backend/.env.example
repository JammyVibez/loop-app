# Copy to .env for local development. Never commit real credentials.
APP_ADDR=0.0.0.0:8080
APP_ENV=development
DATABASE_URL=postgresql://loop:loop_dev_only@127.0.0.1:54329/loop
DB_MAX_CONNECTIONS=10
RUN_MIGRATIONS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://loopapp.me,https://www.loopapp.me

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=loop-local
AWS_SECRET_ACCESS_KEY=local-only-change-me
S3_BUCKET=loop-dev
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400

RUST_LOG=loop_api=info,tower_http=info
