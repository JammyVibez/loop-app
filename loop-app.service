[Unit]
Description=Loop App - Social Platform
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/loop
ExecStart=/usr/bin/node node_modules/.bin/next start -p 3000 -H 0.0.0.0
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
