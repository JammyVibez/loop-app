# Rust API origin. Required in production for /api/v1/* (including the legal consent gate).
# Local development defaults to http://127.0.0.1:8080 when unset.
RUST_API_ORIGIN=

# Legal publication values. Set verified production details in BOTH Next.js and Rust runtimes.
# No agreement can be recorded while any required value remains empty or a placeholder.
